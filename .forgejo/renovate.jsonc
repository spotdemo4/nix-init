{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "forgejo",
  "endpoint": "https://trev.zip/api/v1",
  "repositories": ["llc/nix-init"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "prHourlyLimit": 0,
  "nix": {
    "enabled": true
  },
  // fix PRs for vulnerable direct dependencies, from osv.dev.
  // transitive vulnerabilities are reported by the vulnerable workflow
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "vulnerabilityAlerts": {
    "addLabels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "nix version",
      "depNameTemplate": "NixOS/nix",
      "datasourceTemplate": "github-tags",
      "managerFilePatterns": ["/^action.yaml$/"],
      "matchStrings": ["https://releases.nixos.org/nix/nix-(?<currentValue>.+)/install"],
      "autoReplaceStringTemplate": "https://releases.nixos.org/nix/nix-{{{newValue}}}/install"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchDepNames": ["spotdemo4/nix-init"],
      "matchFileNames": ["action.yaml"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [".forgejo/workflows/*.yaml"],
      "groupName": "forgejo actions"
    },
    {
      "matchFileNames": ["**/action.yaml"],
      "commitMessagePrefix": "feat: "
    }
  ]
}
